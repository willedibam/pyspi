#!/bin/bash
#PBS -N bench_light
#PBS -l select=1:ncpus=12:mem=48gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -m bea
#PBS -M wedi0306@uni.sydney.edu.au

# Light bench grid: M={4,8,16} x T={200,400,800,1600,3200} = 15 cells,
# full config.yaml at n_jobs=1. Sequential (no -J) — one job writes 15
# per-cell JSONs into bench/results/cells/ incrementally; safe to interrupt
# (--resume picks up remaining cells on resubmit).
#
# Submit from the pyspi-fork repo root:
#   qsub bench/physics/run_bench_light.pbs

set -euo pipefail
[[ -z "${PBS_O_WORKDIR:-}" ]] && { echo "[ERROR] submit via qsub"; exit 1; }
cd "$PBS_O_WORKDIR"

LOG_DIR="$PBS_O_WORKDIR/bench/logs"
mkdir -p "$LOG_DIR"
exec >"$LOG_DIR/bench_${PBS_JOBID%%.*}.log" 2>&1

module purge
source ../mts-spi-study-cluster/.venv/bin/activate

export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
       VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 KMP_DUPLICATE_LIB_OK=TRUE
unset CUDA_VISIBLE_DEVICES

echo "[bench] host=$(hostname) start=$(date)"
python -m bench.bench_compute \
    --m 4,8,16 --t 200,400,800,1600,3200 --n-jobs 1 \
    --config config.yaml --repeats 1 \
    --output-dir bench/results/cells --label physics_config \
    --resume
echo "[bench] finished at $(date)"
