#!/bin/bash
#PBS -N pyspi_bench
#PBS -l select=1:ncpus=48:mem=192gb
#PBS -l walltime=168:00:00
#PBS -j oe
#PBS -m bea
#PBS -M wedi0306@uni.sydney.edu.au

# Benchmark pyspi Calculator.compute() on the USYD Physics cluster.
#
# Same logic as run_benchmark.pbs (Gadi); differs only in PBS directives
# (select syntax, no project/queue/storage) and module setup. Submit from the
# pyspi-fork repo root so $PBS_O_WORKDIR resolves there.
#
# Submit with -v overrides, e.g.:
#   # config-cutting grid as a 4-cell array (one (M,T) cell per task):
#   qsub -J 1-4 -v M=32,64,T=1000,4000,CONFIG=config.yaml bench/run_benchmark_physics.pbs
#   # a single (M,T) cell:
#   qsub -v M=64,T=2000,CONFIG=config.yaml bench/run_benchmark_physics.pbs
#
# Env (-v), with defaults:
#   M, T      comma-separated grid axes. If BOTH set, they override PRESET.
#   NJOBS     Calculator.compute n_jobs for an M/T grid (default 1).
#   PRESET    bundled grid: headline | scaling | parallel | amortized [amortized]
#   CONFIG    pyspi config: subset name, bundled filename, or path   [config.yaml]
#   REPEATS   repeats per cell                                       [2]
#   VENV      venv with pyspi installed editable  [../mts-spi-study-cluster/.venv]
#
# Array jobs: submit with -J 1-N where N = number of grid cells; each task
# runs one cell via --array-index to its own JSON. n_jobs=1 within a task.
# Size walltime / mem / ncpus to your queue and the largest (M,T) cell.

set -euo pipefail

if [[ -z "${PBS_O_WORKDIR:-}" ]]; then
  echo "[ERROR] PBS_O_WORKDIR not set — submit via qsub from the pyspi-fork repo root."
  exit 1
fi

PRESET="${PRESET:-amortized}"
CONFIG="${CONFIG:-config.yaml}"
REPEATS="${REPEATS:-2}"
M="${M:-}"
T="${T:-}"
NJOBS="${NJOBS:-1}"
VENV="${VENV:-../mts-spi-study-cluster/.venv}"

cd "${PBS_O_WORKDIR}"

module purge
source "${VENV}/bin/activate"

# BLAS single-threaded — matches the production regime (1 dataset / core).
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export KMP_DUPLICATE_LIB_OK=TRUE

# cdt (transitive pyspi import) does ast.literal_eval(os.environ["CUDA_VISIBLE_DEVICES"]).
unset CUDA_VISIBLE_DEVICES

# Explicit M/T overrides the preset.
if [[ -n "$M" && -n "$T" ]]; then
    GRID=(--m "$M" --t "$T" --n-jobs "$NJOBS")
    LABEL="m${M//,/-}_t${T//,/-}"
else
    GRID=(--preset "$PRESET")
    LABEL="$PRESET"
fi

# Array job: one grid cell per task, each to its own JSON.
ARRAY=()
SUFFIX=""
if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    ARRAY=(--array-index "$PBS_ARRAY_INDEX")
    SUFFIX="_cell${PBS_ARRAY_INDEX}"
fi

OUT="bench/results/physics_${LABEL}${SUFFIX}.json"

echo "[bench] host=$(hostname) start=$(date)"
echo "[bench] grid=${GRID[*]}  config=${CONFIG}  repeats=${REPEATS}"
echo "[bench] out=${OUT}"

python -m bench.bench_compute \
    "${GRID[@]}" "${ARRAY[@]}" \
    --config "${CONFIG}" \
    --repeats "${REPEATS}" \
    --output "${OUT}" \
    --resume

echo "[bench] finished at $(date) -> ${OUT}"
