#!/bin/bash
#PBS -N pyspi_bench
#PBS -l select=1:ncpus=48:mem=192gb
#PBS -l walltime=168:00:00
#PBS -j oe

# Benchmark pyspi Calculator.compute() on a generic PBS Pro cluster (this one
# is sized for the USYD Physics queue).
#
# Output: one JSON per (M,T,n_jobs) cell in bench/results/cells/, named
#         "<label>_M<M>_T<T>_n<n>.json" (label defaults to physics_<config-stem>).
# Logs:   one file per PBS job/task in bench/logs/.
#
# Mail: qsub does NOT expand shell variables inside #PBS directives, so pass
#       your address at submit time instead:
#         qsub -m bea -M you@example.org ... bench/run_benchmark_physics.pbs
#
# Submit examples (note: qsub -v parses commas as variable separators, so for
# comma-containing values use the env-pass form below — set the var in the
# shell, then list its name in -v):
#
#   # Light grid as one sequential job (15 cells -> 15 JSONs):
#   M=4,8,16 T=200,400,800,1600,3200 CONFIG=full REPEATS=1 \
#     qsub -l select=1:ncpus=12:mem=48gb -l walltime=24:00:00 \
#          -v M,T,CONFIG,REPEATS bench/run_benchmark_physics.pbs
#
#   # M=32 grid as a per-cell array (-J 1-5 -> 5 JSONs, in parallel):
#   M=32 T=200,400,800,1600,3200 CONFIG=full REPEATS=1 \
#     qsub -J 1-5 -l select=1:ncpus=16:mem=64gb -l walltime=72:00:00 \
#          -v M,T,CONFIG,REPEATS bench/run_benchmark_physics.pbs
#
# Env (-v), with defaults:
#   M, T      comma-separated grid axes. If BOTH set, they override PRESET.
#   NJOBS     Calculator.compute n_jobs (default 1 — config-cutting regime).
#   PRESET    bundled grid: headline | scaling | parallel | amortized [amortized]
#   CONFIG    pyspi config: bundled name (full/fast/benchmarked_p90/...) or a
#             path to your own YAML                                 [full]
#   REPEATS   repeats per cell                                      [2]
#   LABEL     filename prefix     [physics_<config-stem>]
#   VENV      venv with pyspi installed editable    [$PBS_O_WORKDIR/.venv]
#
# Size walltime / mem / ncpus to your queue and the largest (M,T) cell. Array
# tasks via -J 1-N: each runs one cell via --array-index, own JSON, own log.

set -euo pipefail

if [[ -z "${PBS_O_WORKDIR:-}" ]]; then
  echo "[ERROR] PBS_O_WORKDIR not set — submit via qsub from the pyspi-fork repo root."
  exit 1
fi

cd "${PBS_O_WORKDIR}"

# Logs: one file per PBS job (or per array task) under bench/logs/.
LOG_DIR="${PBS_O_WORKDIR}/bench/logs"
mkdir -p "$LOG_DIR"
JOBID="${PBS_JOBID:-local}"
ARRAY_ID="${PBS_ARRAY_INDEX:-}"
LOG_TAG="${JOBID%%.*}${ARRAY_ID:+_${ARRAY_ID}}"
exec >"$LOG_DIR/bench_${LOG_TAG}.log" 2>&1

PRESET="${PRESET:-amortized}"
CONFIG="${CONFIG:-full}"
REPEATS="${REPEATS:-2}"
M="${M:-}"
T="${T:-}"
NJOBS="${NJOBS:-1}"
VENV="${VENV:-${PBS_O_WORKDIR}/.venv}"
LABEL_DEFAULT="physics_$(basename "${CONFIG}" .yaml)"
LABEL="${LABEL:-$LABEL_DEFAULT}"

module purge
source "${VENV}/bin/activate"

# BLAS single-threaded — matches the production regime (1 dataset / core).
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export KMP_DUPLICATE_LIB_OK=TRUE

# cdt (transitive pyspi import) does ast.literal_eval(os.environ["CUDA_VISIBLE_DEVICES"]).
unset CUDA_VISIBLE_DEVICES

# Explicit M/T overrides the preset.
if [[ -n "$M" && -n "$T" ]]; then
    GRID=(--m "$M" --t "$T" --n-jobs "$NJOBS")
else
    GRID=(--preset "$PRESET")
fi

# Array job: one grid cell per task.
ARRAY=()
if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    ARRAY=(--array-index "$PBS_ARRAY_INDEX")
fi

echo "[bench] host=$(hostname) start=$(date)"
echo "[bench] config=${CONFIG}  grid=${GRID[*]} ${ARRAY[*]}  repeats=${REPEATS}"
echo "[bench] label=${LABEL}  output_dir=bench/results/cells/"

python -m bench.bench_compute \
    "${GRID[@]}" "${ARRAY[@]}" \
    --config "${CONFIG}" \
    --repeats "${REPEATS}" \
    --output-dir bench/results/cells \
    --label "${LABEL}" \
    --resume

echo "[bench] finished at $(date)"
