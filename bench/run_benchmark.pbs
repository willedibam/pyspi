#!/bin/bash
#PBS -N pyspi_bench
#PBS -P ql44
#PBS -q normal
#PBS -l walltime=10:00:00
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l jobfs=10GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -j oe

# Benchmark pyspi Calculator.compute() on Gadi.
#
# Output: one JSON per (M,T,n_jobs) cell in bench/results/cells/, named
#         "<label>_M<M>_T<T>_n<n>.json" (label defaults to gadi_<config-stem>).
# Logs:   one file per PBS job/task in bench/logs/.
#
# Mail: qsub does NOT expand shell variables inside #PBS directives, so pass
#       your address at submit time instead:
#         qsub -m bea -M you@example.org ... bench/run_benchmark.pbs
#
# Submit examples (qsub -v parses commas as separators — env-pass for
# comma-containing values):
#
#   # config-cutting grid as a 4-cell array (one (M,T) cell per task):
#   M=32,80 T=500,2000 CONFIG=full REPEATS=2 \
#     qsub -J 1-4 -v M,T,CONFIG,REPEATS bench/run_benchmark.pbs
#
#   # single (M,T) cell:
#   M=64 T=2000 CONFIG=full REPEATS=2 \
#     qsub -v M,T,CONFIG,REPEATS bench/run_benchmark.pbs
#
#   # bundled preset (parallel speedup curve):
#   qsub -v PRESET=parallel,CONFIG=benchmarked_p90 bench/run_benchmark.pbs
#
# Env (-v), with defaults:
#   M, T      comma-separated grid axes. If BOTH set, they override PRESET.
#   NJOBS     Calculator.compute n_jobs (default 1).
#   PRESET    bundled grid: headline | scaling | parallel | amortized [amortized]
#   CONFIG    pyspi config: bundled name (full/fast/benchmarked_p90/...) or a
#             path to your own YAML                                 [full]
#   REPEATS   repeats per cell                                      [2]
#   LABEL     filename prefix     [gadi_<config-stem>]
#   PYSPI_DIR pyspi-fork checkout       [/scratch/ql44/<user>/pyspi-fork]
#   VENV      venv with pyspi installed editable        [$PYSPI_DIR/.venv]

set -euo pipefail

PRESET="${PRESET:-amortized}"
CONFIG="${CONFIG:-full}"
REPEATS="${REPEATS:-2}"
M="${M:-}"
T="${T:-}"
NJOBS="${NJOBS:-1}"
PYSPI_DIR="${PYSPI_DIR:-/scratch/ql44/${USER}/pyspi-fork}"
VENV="${VENV:-${PYSPI_DIR}/.venv}"
LABEL_DEFAULT="gadi_$(basename "${CONFIG}" .yaml)"
LABEL="${LABEL:-$LABEL_DEFAULT}"

cd "${PYSPI_DIR}"

# Logs: one file per PBS job (or per array task) under bench/logs/.
LOG_DIR="${PYSPI_DIR}/bench/logs"
mkdir -p "$LOG_DIR"
JOBID="${PBS_JOBID:-local}"
ARRAY_ID="${PBS_ARRAY_INDEX:-}"
LOG_TAG="${JOBID%%.*}${ARRAY_ID:+_${ARRAY_ID}}"
exec >"$LOG_DIR/bench_${LOG_TAG}.log" 2>&1

module purge
module load python3/3.12.1
source "${VENV}/bin/activate"

# BLAS single-threaded — matches production regime (1 dataset / core).
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export KMP_DUPLICATE_LIB_OK=TRUE

unset CUDA_VISIBLE_DEVICES

# Explicit M/T overrides the preset.
if [[ -n "$M" && -n "$T" ]]; then
    GRID=(--m "$M" --t "$T" --n-jobs "$NJOBS")
else
    GRID=(--preset "$PRESET")
fi

# Array job: one grid cell per task.
ARRAY=()
if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    ARRAY=(--array-index "$PBS_ARRAY_INDEX")
fi

echo "[bench] host=$(hostname) start=$(date)"
echo "[bench] config=${CONFIG}  grid=${GRID[*]} ${ARRAY[*]}  repeats=${REPEATS}"
echo "[bench] label=${LABEL}  output_dir=bench/results/cells/"

python -m bench.bench_compute \
    "${GRID[@]}" "${ARRAY[@]}" \
    --config "${CONFIG}" \
    --repeats "${REPEATS}" \
    --output-dir bench/results/cells \
    --label "${LABEL}" \
    --resume

echo "[bench] finished at $(date)"
